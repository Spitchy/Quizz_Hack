# Copier vers .env.local (ignoré par git)
VITE_API_BASE_URL=http://localhost:3000
# true = mock en mémoire conforme au contrat, sans le back
VITE_API_MOCK=false

# corridor = couloir droit de test, sinon labyrinthe
VITE_MAZE_LAYOUT=maze

# true = bonne réponse cochée sur les panneaux (dev + mock seulement)
VITE_SHOW_ANSWERS=false
