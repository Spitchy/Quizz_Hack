# Port d'écoute du serveur Express
PORT=3000

# URL de l'API externe du Hub (FSQ Hub)
HUB_API_URL=https://hub.fsq-games.internal

# Clé secrète de jeu transmise dans le header X-Game-Key lors de la soumission des scores
X_GAME_KEY=game_secret_key_horror_maze_2026_xyz

# Mode Mock pour le Hub (activer pour le développement local sans serveur Hub actif)
MOCK_HUB=true
